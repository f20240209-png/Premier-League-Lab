# API key remains server-side. Never commit .env.
API_FOOTBALL_KEY=
BBS_API_KEY=
FOOTBALL_DATA_ORG_KEY=
# Empty uses an isolated local SQLite database. MySQL also supported.
DATABASE_URL=
# Existing DB_HOST/DB_USER/DB_PASSWORD/DB_NAME variables are supported.
FLASK_SECRET_KEY=
ADMIN_PASSWORD_HASH=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Set APP_ENV=production and COOKIE_SECURE=true behind HTTPS.
APP_ENV=development
COOKIE_SECURE=false
# Production: use a shared Redis-compatible limiter storage URI.
RATELIMIT_STORAGE_URI=memory://
# Migration only: external PostgreSQL URL with sslmode=require. Remove after use.
MIGRATION_TARGET_URL=
